{
  "name": "career-ops",
  "version": "1.0.0",
  "description": "AI-powered job search pipeline built on Claude Code",
  "scripts": {
    "doctor": "node scripts/maintenance/doctor.mjs",
    "verify": "node scripts/core/verify-pipeline.mjs",
    "normalize": "node scripts/core/normalize-statuses.mjs",
    "dedup": "node scripts/core/dedup-tracker.mjs",
    "merge": "node scripts/core/merge-tracker.mjs",
    "pdf": "node scripts/cv/generate-pdf.mjs",
    "sync-check": "node scripts/cv/cv-sync-check.mjs",
    "update:check": "node scripts/maintenance/update-system.mjs check",
    "update": "node scripts/maintenance/update-system.mjs apply",
    "rollback": "node scripts/maintenance/update-system.mjs rollback",
    "liveness": "node scripts/jobs/check-liveness.mjs",
    "scan": "node scripts/jobs/scan.mjs",
    "gemini:eval": "node scripts/jobs/gemini-eval.mjs",
    "test:all": "node scripts/maintenance/test-all.mjs",
    "api": "node gui/server.mjs",
    "gui:dev": "cd gui && npm run dev",
    "gui:build": "cd gui && npm run build",
    "gui:preview": "cd gui && npm run preview"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1"
  },
  "devDependencies": {
    "axios": "^1.15.2"
  }
}
